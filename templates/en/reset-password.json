{
  "id": "reset-password",
  "group": "app",
  "title": "Reset password",
  "subject": "Reset your {{app_name}} password",
  "preheader": "This link works for {{expires_in}}.",
  "previewHeight": 560,
  "variables": [
    {
      "name": "name",
      "description": "The person's name",
      "example": "Mali"
    },
    {
      "name": "app_name",
      "description": "Your app's name",
      "example": "Cafe Meow"
    },
    {
      "name": "url",
      "description": "The password reset link",
      "example": "https://example.com/reset"
    },
    {
      "name": "expires_in",
      "description": "How long it stays valid, written the way you want it shown",
      "example": "10 minutes"
    }
  ]
}
