---
// SITE.md rule 4: the toggle writes mm_lang, shared with the site and app on .mailmeow.dev.
const path = Astro.url.pathname;
const current = /^\/th(\/|$)/.test(path) ? 'th' : 'en';
const to = (l: string) => path.replace(/^\/(en|th)(?=\/|$)/, `/${l}`);
const langs = [
  { code: 'en', label: 'EN', name: 'English' },
  { code: 'th', label: 'TH', name: 'ไทย' },
];
---
<ul class="lang-toggle">
  {langs.map((l) => (
    <li>
      <a href={to(l.code)} hreflang={l.code} lang={l.code} title={l.name} data-set-lang={l.code} aria-current={l.code === current ? 'true' : undefined}>{l.label}</a>
    </li>
  ))}
</ul>
<script>
  // Browsers reject a cookie for a domain the page is not on (localhost, *.pages.dev previews): there it stays host-only.
  document.querySelectorAll<HTMLAnchorElement>('a[data-set-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      const onSite = location.hostname === 'mailmeow.dev' || location.hostname.endsWith('.mailmeow.dev');
      const domain = onSite ? '; Domain=.mailmeow.dev' : '';
      document.cookie = `mm_lang=${a.dataset.setLang}${domain}; Path=/; Max-Age=31536000; SameSite=Lax`;
    });
  });
</script>
